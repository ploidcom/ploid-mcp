{
  "name": "@ploid/mcp",
  "version": "0.2.0",
  "description": "Ploid people intelligence for MCP-compatible agents.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://ploid.com/documentation/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/ploidcom/ploid-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ploidcom/ploid-mcp/issues"
  },
  "bin": {
    "ploid-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src test",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "oxlint": "^1.16.0",
    "tsup": "^8.2.4",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "packageManager": "pnpm@9.15.0"
}
