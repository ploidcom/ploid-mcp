{
  "info": {
    "name": "Ploid Public API (v1)",
    "description": "Agent-native people search and enrichment API.\n\nBase URL: https://api.ploid.com\n\n## Setup\n1. Open the collection **Variables** tab.\n2. Set `apiKey` to your Ploid API key (from Settings → API Keys).\n3. `baseUrl` defaults to `https://api.ploid.com`.\n\nAuth is sent on every request via the `x-api-key` header (collection-level auth). Requests wrap payloads in `{ \"data\": ..., \"meta\": ... }`; errors use `{ \"error\": { \"code\", \"message\", \"request_id\" } }`.\n\nCredits: 1 credit = $0.10. Search bills 1 credit per 10 results; socials 1 credit each; work email 1, personal email 3, mobile phone 10. Failed fields are never billed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "x-api-key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.ploid.com", "type": "string" },
    { "key": "apiKey", "value": "sk_live_replace_me", "type": "string" },
    { "key": "peopleSetId", "value": "", "type": "string" },
    { "key": "batchId", "value": "", "type": "string" },
    { "key": "jobId", "value": "", "type": "string" },
    { "key": "monitorId", "value": "", "type": "string" },
    { "key": "webhookId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Agent",
      "item": [
        {
          "name": "Stream agent chat",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/agent/chat", "host": ["{{baseUrl}}"], "path": ["v1", "agent", "chat"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Find heads of growth at seed-stage AI startups in SF\",\n  \"mode\": \"people\",\n  \"model\": \"atlas\",\n  \"session_id\": \"my-session-1\"\n}"
            },
            "description": "Streams AI SDK SSE parts (text, tool, phase, narration, data-subagent). Scope: agent:chat."
          }
        },
        {
          "name": "Cancel agent sub-agent",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/agent/chat/cancel", "host": ["{{baseUrl}}"], "path": ["v1", "agent", "chat", "cancel"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chat_id\": \"my-session-1\",\n  \"tool_call_id\": \"tool_123\",\n  \"angle_id\": \"*\"\n}"
            },
            "description": "Stops one deep-search angle (or all with '*'). Scope: agent:cancel."
          }
        }
      ]
    },
    {
      "name": "People",
      "item": [
        {
          "name": "Search people (natural)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/people/search", "host": ["{{baseUrl}}"], "path": ["v1", "people", "search"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"natural\",\n  \"query\": \"founders of YC-backed devtools startups\",\n  \"page\": { \"size\": 25 },\n  \"enrich\": [\"github\", \"x\"]\n}"
            },
            "description": "Scope: people:search. Natural mode supports 25-1000 results."
          }
        },
        {
          "name": "Search people (table filters)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/people/search", "host": ["{{baseUrl}}"], "path": ["v1", "people", "search"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"table\",\n  \"filters\": {\n    \"jobTitles\": [\"Founder\", \"CEO\"],\n    \"locations\": [\"San Francisco\"],\n    \"keywords\": [\"AI\"]\n  },\n  \"page\": { \"size\": 50 }\n}"
            },
            "description": "Scope: people:search. Keywords are hard filters; jobTitles use role-intent matching."
          }
        },
        {
          "name": "Create criteria search (async)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/people/search/criteria", "host": ["{{baseUrl}}"], "path": ["v1", "people", "search", "criteria"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"engineering leaders who have scaled a team past 50\",\n  \"count\": 50,\n  \"criteria\": [\n    { \"label\": \"Managed 50+ engineers\", \"intent\": \"required\" },\n    { \"label\": \"Worked at a public company\", \"intent\": \"preferred\" }\n  ],\n  \"enrich\": [\"work_email\"]\n}"
            },
            "description": "Scope: people:search. Returns a job_id to poll."
          }
        },
        {
          "name": "Get criteria search",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/v1/people/search/criteria/{{jobId}}", "host": ["{{baseUrl}}"], "path": ["v1", "people", "search", "criteria", "{{jobId}}"] },
            "description": "Poll a criteria search job. Scope: people:search."
          }
        },
        {
          "name": "Lookup person",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/people/lookup", "host": ["{{baseUrl}}"], "path": ["v1", "people", "lookup"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"company\": \"Acme Inc\"\n}"
            },
            "description": "Scope: people:lookup."
          }
        },
        {
          "name": "Enrich person",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/people/enrich", "host": ["{{baseUrl}}"], "path": ["v1", "people", "enrich"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"company\": \"Acme Inc\",\n  \"linkedin_url\": \"https://www.linkedin.com/in/janedoe\",\n  \"fields\": [\"profile\", \"github\", \"work_email\"]\n}"
            },
            "description": "Scope: people:enrich. Email/phone reveals require a paid plan or a card on file."
          }
        },
        {
          "name": "Estimate batch enrichment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/people/estimate", "host": ["{{baseUrl}}"], "path": ["v1", "people", "estimate"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"people\": [\n    { \"name\": \"Jane Doe\", \"company\": \"Acme Inc\" },\n    { \"linkedin_url\": \"https://www.linkedin.com/in/johndoe\" }\n  ],\n  \"fields\": [\"github\", \"x\", \"instagram\"]\n}"
            },
            "description": "Scope: people:enrich."
          }
        },
        {
          "name": "Create batch enrichment (async)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/people/batch/enrich", "host": ["{{baseUrl}}"], "path": ["v1", "people", "batch", "enrich"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"people\": [\n    { \"name\": \"Jane Doe\", \"company\": \"Acme Inc\" },\n    { \"linkedin_url\": \"https://www.linkedin.com/in/johndoe\" }\n  ],\n  \"fields\": [\"github\", \"x\", \"instagram\"],\n  \"webhook_url\": \"https://example.com/webhooks/ploid\"\n}"
            },
            "description": "Scope: batch:write. Up to 500 people."
          }
        },
        {
          "name": "Get batch status",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/v1/people/batch/{{batchId}}", "host": ["{{baseUrl}}"], "path": ["v1", "people", "batch", "{{batchId}}"] },
            "description": "Scope: batch:write."
          }
        },
        {
          "name": "List batch results",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/people/batch/{{batchId}}/results?cursor=0&limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "people", "batch", "{{batchId}}", "results"],
              "query": [
                { "key": "cursor", "value": "0" },
                { "key": "limit", "value": "100" }
              ]
            },
            "description": "Scope: batch:write."
          }
        }
      ]
    },
    {
      "name": "Search (People Sets)",
      "item": [
        {
          "name": "Create People Set",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.people_set_id) {",
                  "  pm.collectionVariables.set('peopleSetId', json.data.people_set_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/searches", "host": ["{{baseUrl}}"], "path": ["v1", "searches"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AI founders\",\n  \"mode\": \"natural\",\n  \"query\": \"founders of AI infrastructure startups\",\n  \"count\": 100,\n  \"include\": [\"github\"],\n  \"webhook_url\": \"https://example.com/webhooks/ploid\"\n}"
            },
            "description": "Scope: people:search. Saves people_set_id to a collection variable."
          }
        },
        {
          "name": "List People Sets",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/searches?limit=25",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "searches"],
              "query": [{ "key": "limit", "value": "25" }]
            },
            "description": "Scope: people:search."
          }
        },
        {
          "name": "Get People Set",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/v1/searches/{{peopleSetId}}", "host": ["{{baseUrl}}"], "path": ["v1", "searches", "{{peopleSetId}}"] },
            "description": "Scope: people:search."
          }
        },
        {
          "name": "List People Set items",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/searches/{{peopleSetId}}/items?cursor=0&limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "searches", "{{peopleSetId}}", "items"],
              "query": [
                { "key": "cursor", "value": "0" },
                { "key": "limit", "value": "100" }
              ]
            },
            "description": "Scope: people:search."
          }
        },
        {
          "name": "Refine People Set",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/searches/{{peopleSetId}}/refine", "host": ["{{baseUrl}}"], "path": ["v1", "searches", "{{peopleSetId}}", "refine"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"only those based in Europe\",\n  \"behavior\": \"append\"\n}"
            },
            "description": "Scope: people:search."
          }
        },
        {
          "name": "Enrich People Set items",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/searches/{{peopleSetId}}/enrichments", "host": ["{{baseUrl}}"], "path": ["v1", "searches", "{{peopleSetId}}", "enrichments"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fields\": [\"work_email\", \"github\"]\n}"
            },
            "description": "Scope: people:enrich. Omit item_ids to enrich the whole set."
          }
        },
        {
          "name": "Export People Set",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/searches/{{peopleSetId}}/exports", "host": ["{{baseUrl}}"], "path": ["v1", "searches", "{{peopleSetId}}", "exports"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"format\": \"csv\"\n}"
            },
            "description": "Scope: people:search."
          }
        }
      ]
    },
    {
      "name": "LinkedIn",
      "item": [
        {
          "name": "Get LinkedIn profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/linkedin/profile?url=https://www.linkedin.com/in/williamhgates",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "linkedin", "profile"],
              "query": [{ "key": "url", "value": "https://www.linkedin.com/in/williamhgates" }]
            },
            "description": "Scope: linkedin:read. Accepts URL, slug, or @handle."
          }
        },
        {
          "name": "Search LinkedIn people",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/linkedin/search", "host": ["{{baseUrl}}"], "path": ["v1", "linkedin", "search"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filters\": {\n    \"keywords\": \"machine learning\",\n    \"title\": \"Engineer\",\n    \"location\": \"United States\"\n  },\n  \"limit\": 25\n}"
            },
            "description": "Scope: linkedin:read."
          }
        },
        {
          "name": "List LinkedIn posts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/linkedin/posts?identifier=williamhgates&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "linkedin", "posts"],
              "query": [
                { "key": "identifier", "value": "williamhgates" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Scope: linkedin:read."
          }
        }
      ]
    },
    {
      "name": "Monitors",
      "item": [
        {
          "name": "List monitors",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/v1/monitors", "host": ["{{baseUrl}}"], "path": ["v1", "monitors"] },
            "description": "Scope: people:search."
          }
        },
        {
          "name": "Create monitor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/monitors", "host": ["{{baseUrl}}"], "path": ["v1", "monitors"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Weekly AI founders\",\n  \"query\": \"new founders of AI startups\",\n  \"interval_days\": 7,\n  \"webhook_url\": \"https://example.com/webhooks/ploid\"\n}"
            },
            "description": "Scope: people:search. Provide query or people_set_id."
          }
        },
        {
          "name": "Delete monitor",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/v1/monitors/{{monitorId}}", "host": ["{{baseUrl}}"], "path": ["v1", "monitors", "{{monitorId}}"] },
            "description": "Scope: people:search."
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "List webhooks",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/v1/webhooks", "host": ["{{baseUrl}}"], "path": ["v1", "webhooks"] },
            "description": "Scope: webhooks:write."
          }
        },
        {
          "name": "Create webhook",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/webhooks", "host": ["{{baseUrl}}"], "path": ["v1", "webhooks"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/webhooks/ploid\",\n  \"events\": [\"batch.completed\", \"people_set.completed\"],\n  \"secret\": \"a-shared-secret-at-least-16-chars\"\n}"
            },
            "description": "Scope: webhooks:write. URL is probed with a test POST that must return 2xx."
          }
        },
        {
          "name": "Delete webhook",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/v1/webhooks/{{webhookId}}", "host": ["{{baseUrl}}"], "path": ["v1", "webhooks", "{{webhookId}}"] },
            "description": "Scope: webhooks:write."
          }
        }
      ]
    },
    {
      "name": "Account",
      "item": [
        {
          "name": "Get credits",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/v1/account/credits", "host": ["{{baseUrl}}"], "path": ["v1", "account", "credits"] },
            "description": "Scope: account:read."
          }
        },
        {
          "name": "Get usage",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/v1/account/usage", "host": ["{{baseUrl}}"], "path": ["v1", "account", "usage"] },
            "description": "Scope: account:read."
          }
        },
        {
          "name": "Revoke current key",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/v1/account/key", "host": ["{{baseUrl}}"], "path": ["v1", "account", "key"] },
            "description": "Revokes the API key used for this request. Scope: account:read."
          }
        }
      ]
    },
    {
      "name": "Meta",
      "item": [
        {
          "name": "Get OpenAPI document",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/v1/openapi.json", "host": ["{{baseUrl}}"], "path": ["v1", "openapi.json"] },
            "description": "Machine-readable OpenAPI definition (no auth required)."
          }
        }
      ]
    }
  ]
}
