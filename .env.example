# Copy to .env and adjust. Every variable is optional in local dev —
# the defaults give you mock data with no auth.
# Note: nothing loads .env automatically; run e.g. `node --env-file=.env dist/index.js`
# (or export the vars via your process manager / platform config).

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
# External URL of this server (scheme + host, no trailing slash). Used in
# OAuth discovery metadata and the connect flow. Required behind a proxy or
# tunnel; defaults to the incoming request origin.
#BASE_URL=https://mcp.ploid.com

# ── Ploid API ───────────────────────────────────────────────────────────────
# mock = in-repo fake data (default), live = real Ploid API.
PLOID_MODE=mock
#PLOID_API_BASE_URL=https://api.ploid.com
# Server-level fallback key, used only when a request carries no per-user key
# (single-tenant / dev use). Scopes needed: people:search, people:lookup,
# people:enrich, account:read.
#PLOID_API_KEY=sk_live_...

# ── Auth ────────────────────────────────────────────────────────────────────
# dev = accept every request unauthenticated (default), oauth = require bearer
# tokens (built-in OAuth flow where users paste their Ploid API key).
AUTH_MODE=dev
# Encrypts OAuth tokens (any long random string; `openssl rand -hex 32`).
# REQUIRED in production with AUTH_MODE=oauth: without it a random key is
# generated per boot, so tokens die on restart and don't work across
# instances. Rotating it forces every user to reconnect.
#MCP_TOKEN_SECRET=
# Only to delegate OAuth to an external authorization server instead of the
# built-in one (e.g. a future login flow on ploid.com).
#AUTH_ISSUER=
